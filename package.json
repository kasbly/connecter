{
  "name": "@kasbly/connector",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "connector": "./dist/setup/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist .next .next-pending .turbo tsconfig.tsbuildinfo *.tsbuildinfo coverage playwright-report test-results .astro",
    "start": "node dist/index.js",
    "setup": "tsx src/setup/cli.ts setup",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.1.0",
    "@inquirer/prompts": "^8.5.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "js-yaml": "^5.2.2",
    "knex": "^3.3.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": ">=3.3.17"
  }
}
