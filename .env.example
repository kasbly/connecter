# Database credentials
DB_HOST=localhost
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password
# Optional: PEM CA certificate/bundle when database.sslCa uses ${DB_SSL_CA}.
# A PEM spans several lines, so keep the whole bundle inside one pair of quotes:
# DB_SSL_CA="-----BEGIN CERTIFICATE-----
# MIIB...
# -----END CERTIFICATE-----"

# Connector API key (shared with Kasbly)
CONNECTOR_API_KEY=kc_change_me_to_a_secure_key

# Public DNS name for the bundled HTTPS proxy. Point its A/AAAA record at this host.
CONNECTOR_DOMAIN=connector.example.com

# Optional: Config file path (default: ./connector.config.yml)
# CONFIG_PATH=./connector.config.yml
