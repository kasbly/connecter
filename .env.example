# Database credentials
# If you run the bundled Docker Compose reverse proxy (recommended, `docker compose
# up -d`), "localhost" here is a trap: the connector runs inside a container, where
# localhost means that container, not this host. `npm run setup` detects this and
# rewrites DB_HOST to host.docker.internal automatically for that topology (#28245)
# — only hand-edit this to `localhost` for the `custom`/`none` topologies, where the
# connector runs directly on this host.
DB_HOST=localhost
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password
# Optional: PEM CA certificate/bundle when database.sslCa uses ${DB_SSL_CA}.
# A PEM spans several lines, so keep the whole bundle inside one pair of quotes:
# DB_SSL_CA="-----BEGIN CERTIFICATE-----
# MIIB...
# -----END CERTIFICATE-----"

# Connector API key (shared with Kasbly)
CONNECTOR_API_KEY=kc_change_me_to_a_secure_key

# Public DNS name for the bundled HTTPS proxy. Point its A/AAAA record at this host.
CONNECTOR_DOMAIN=connector.example.com

# Host interface docker-compose.yml publishes the connector's port (4000) on.
# Defaults to 127.0.0.1 (loopback only), which is correct for the bundled Caddy
# proxy and for a "custom" proxy on this same host. `npm run setup` sets this to
# 0.0.0.0 when you choose the "None" reverse-proxy topology, since that is the
# only case where the connector must be reachable directly from the network.
# CONNECTOR_BIND=127.0.0.1

# Optional: Config file path (default: ./connector.config.yml)
# CONFIG_PATH=./connector.config.yml
